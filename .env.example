# JLegal Environment Configuration

# Database
DATABASE_URL=postgresql://jlegal:jlegal@db:5432/jlegal
POSTGRES_USER=jlegal
POSTGRES_PASSWORD=jlegal
POSTGRES_DB=jlegal

# Redis
REDIS_URL=redis://redis:6379/0

# Storage
STORAGE_PATH=/app/storage
MAX_UPLOAD_SIZE=104857600

# Workers
WORKERS_PER_CONTAINER=4

# OCR
OCR_LANGUAGES=eng

# API
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# Security (change in production!)
SECRET_KEY=change-this-in-production-to-a-random-string
